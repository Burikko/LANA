<WeatherDashboard>
    BoxLayout:
        orientation: 'vertical'
        Label:
            text: 'Weather Dashboard'
            font_size: '24sp'
        TextInput:
            id: location_input
            hint_text: 'Enter location'
        Button:
            text: 'Get Weather'
            on_press: app.get_weather(location_input.text)
        Label:
            id: weather_info
            text: 'Weather info will appear here'
